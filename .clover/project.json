{
  "$schema": "https://cloverapps.ai/schemas/project-build-policy-v1.json",
  "schemaVersion": "1.0",
  "protocolVersion": "1.0.0",
  "project": {
    "id": "rollindd-platform",
    "title": "RollinDD",
    "owner": "Chris Dortch",
    "repository": "chrisdortch/rollindd-platform",
    "vercelProjectId": "prj_fCBwTx9W9T6ZV36sEyRAakiAlqRc",
    "productionBranch": "main",
    "productionDomain": "rollindd-platform.vercel.app"
  },
  "risk": {
    "classification": "medium",
    "runtime": "public music platform with protected administrative writes",
    "productionData": "Neon/Vercel Postgres is configured",
    "payments": false,
    "listenerPersonalDataRequired": false,
    "externalMediaProviders": [
      "Suno"
    ],
    "previewDataPolicy": "CI receives no production database or admin credentials and may not perform writes"
  },
  "build": {
    "defaultMode": "preview-only",
    "allowedBranchPrefixes": [
      "chatpro/",
      "agent/",
      "codex/"
    ],
    "blockSensitivePathChanges": true,
    "bootstrapCommands": [
      {
        "id": "install-locked-dependencies",
        "command": "npm ci --no-audit --no-fund"
      },
      {
        "id": "install-browser-engines",
        "command": "npx playwright install --with-deps chromium webkit"
      }
    ],
    "requiredCommands": [
      {
        "id": "lint",
        "command": "npm run lint"
      },
      {
        "id": "typecheck",
        "command": "npm run typecheck"
      },
      {
        "id": "production-build",
        "command": "npm run build"
      },
      {
        "id": "browser-e2e",
        "command": "npm run test:e2e"
      }
    ],
    "requiredEvidence": [
      "project-policy hash",
      "source and base commits",
      "complete changed-file list",
      "sensitive-path assessment",
      "automated check receipt",
      "desktop Chromium interaction pass",
      "mobile WebKit interaction pass",
      "Vercel preview deployment",
      "preview URL",
      "owner visual review",
      "production boundary confirmation"
    ]
  },
  "ownerApprovalRequiredFor": [
    "merge to main",
    "production deployment or promotion",
    "production alias change",
    "custom domain or DNS change",
    "database schema or production-data mutation",
    "environment-variable or secret change",
    "new paid service or recurring cost"
  ],
  "forbiddenInPreview": [
    "force-push to main",
    "production deployment",
    "production alias assignment",
    "custom domain or DNS mutation",
    "destructive database operation",
    "secret-value disclosure",
    "cross-project resource reuse"
  ],
  "sensitivePaths": [
    "sql/**",
    ".env*",
    "app/api/admin/**",
    "app/api/central-command/**"
  ],
  "receipt": {
    "artifactPath": ".clover/artifacts/build-receipt.json",
    "retentionDays": 30,
    "statusValues": [
      "passed",
      "failed"
    ]
  }
}
